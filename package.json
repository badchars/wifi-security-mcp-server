{
  "name": "wifi-security-mcp-server",
  "version": "0.1.0",
  "description": "Full-spectrum wireless security MCP server — WiFi (WPA/WPA2/WPA3, KRACK, Dragonblood, PMKID, Evil Twin), Bluetooth (BlueBorne, KNOB, BLE), RF/SDR (RollJam, sub-GHz), NFC/RFID (Mifare, EMV relay), Cellular/5G (IMSI, SS7), IoT (Zigbee, Z-Wave, LoRa, MQTT), MouseJack, air-gap exfiltration, WiFi CSI, UWB, drone RF, wireless forensics, WIDS/WIPS, compliance",
  "type": "module",
  "bin": {
    "wifi-security-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
